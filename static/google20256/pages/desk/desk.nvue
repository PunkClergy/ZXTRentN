<template>
	<view class="container" :style="containerStyle" @touchmove.prevent="handleTouchMove">
		<!-- 头部内容 -->
		<view class="custom-navbar" :style="navbarStyle">
			<view class="logo-container">
				<image :src="safeLogo" mode="widthFix" @tap="handleJumpHome" class="logo-img" />
				<text class="title">智信通wiselink</text>
			</view>

			<!-- 用户登录状态 -->
			<view v-if="userInfo" class="login-info">
				{{ userCompanyName }}(已登录)
			</view>
			<view v-else class="login-btn" @tap.stop="handleNavigateToLogin">
				去登录
			</view>
		</view>
		<!-- 轮播图 -->
		<view class="content-container">
			<swiper class="swiper" :autoplay="true" :interval="3000" :duration="500">
				<swiper-item v-for="(item, index) in bannerList" :key="index">
					<image :src="getBannerUrl(item.img)" mode="aspectFill" class="swiper-image"
						@click="handleSwiperClick(item)" />
				</swiper-item>
			</swiper>
		</view>
		<!-- 快捷菜单区域 -->
		<view class="quick-container">
			<swiper class="quick-swiper" :autoplay="true" :interval="3000" :duration="500">
				<swiper-item v-for="(page, pageIndex) in menuPages" :key="pageIndex">
					<view class="menu-grid">
						<view v-for="(item, itemIndex) in page" :key="`menu-${item.id || itemIndex}`" class="menu-item"
							@tap="handleMenuItemTap(item)">
							<view class="menu-item-current">
								<image :src="getMenuIconUrl(item.icon)" mode="scaleToFill" class="menu-icon"
									@error="handleMenuIconError(item.id)" />
								<text class="menu-text">{{ item.name }}</text>
							</view>
						</view>
					</view>
				</swiper-item>
			</swiper>
		</view>

		<!-- 地图内容 -->
		<view class="maps" style="margin: 0 10rpx;background-color: aqua;">
			<web-view ref="webview" style="background-color: #fafafa;" :style="{ height: viewportHeight + 'px' }"
				@onPostMessage="handlePostMessage" :src="webUrlWithTimestamp"></web-view>
		</view>
	</view>
</template>

<script>
	import {
		info_screen
	} from '@/utils/scheme/screen.js'
	import {
		u_logo,
		u_bannerlist,
		u_midMenulist
	} from '@/api'
	import 'url-search-params-polyfill';
	const DEFAULT_MENU_ICON = '/static/public/default-icon.png';
	const MENU_ITEMS_PER_PAGE = 5; // 每页菜单项数量
	export default {
		data() {
			return {
				screenInfo: {}, // 屏幕信息对象
				logo: '', // Logo图片地址
				baseLink: 'https://k1sw.wiselink.net.cn', // 基础域名
				viewportHeight: 332, // 页面高度
				isLoading: false,
				nowTimestamp: Date.now(), // 缓存时间戳
				// 轮播图数据/（示例数据）
				bannerList: [],
				menuList: [], // 菜单原始数据
				imageErrors: new Set(), // 图片加载错误记录
				iconErrors: new Set(), // 图标加载错误记录
			}
		},
		computed: {
			// 当前用户信息
			userInfo() {
				return uni.getStorageSync('user_info') || null
			},
			// 有效的菜单数据
			validMenuItems() {
				return this.menuList.filter(item => item?.name?.trim());
			},
			// 是否有菜单数据
			hasMenuData() {
				return this.validMenuItems.length > 0 && !this.isLoading;
			},
			// 安全的公司名称显示
			userCompanyName() {
				return this.userInfo?.companyName?.trim() || '未知'
			},
			// 菜单分页数据
			menuPages() {
				const pages = [];
				const items = [...this.validMenuItems];

				while (items.length) {
					pages.push(items.splice(0, MENU_ITEMS_PER_PAGE));
				}

				return pages;
			},
			// 导航栏总高度
			navbarTotalHeight() {
				const statusBarHeight = this.screenInfo.statusBarHeight || 0
				const navBarHeight = this.screenInfo.platform === 'ios' ? 49 : 44
				return statusBarHeight + navBarHeight
			},

			// 安全的Logo地址
			safeLogo() {
				return this.logo || '/static/default-logo.png'
			},

			// 容器样式
			containerStyle() {
				return {
					height: `${this.screenInfo.screenHeight || 667}px`
				}
			},

			// 导航栏样式
			navbarStyle() {
				return {
					marginTop: `${this.screenInfo.statusBarHeight}px`,
					width: `${this.screenInfo.screenWidth}px`
				}
			},

			// 带时间戳的Web URL
			webUrlWithTimestamp() {
				return `/hybrid/html/homePgae.html?nowTime=${this.nowTimestamp}`
			}
		},
		methods: {
			// 阻止默认滚动行为
			handleTouchMove() {
				return false
			},

			// 跳转首页
			handleJumpHome() {
				uni.reLaunch({
					url: '/pages/desk/desk'
				})
			},

			// 跳转登录页
			handleNavigateToLogin() {
				uni.navigateTo({
					url: '/pages/login/login'
				})
			},

			// 初始化屏幕信息
			async initialScreenInfo() {
				try {
					this.screenInfo = await info_screen()
					// 生产环境移除console
					if (process.env.NODE_ENV === 'development') {
						console.log('Screen info:', this.screenInfo)
					}
				} catch (error) {
					console.error('[ScreenInfo] 获取屏幕信息失败:', error)
					uni.showToast({
						title: '设备信息获取失败',
						icon: 'none'
					})
				}
			},

			// 初始化应用Logo
			async initialLogo() {
				try {
					const res = await u_logo()
					if (res?.content?.img) {
						this.logo = `${this.baseLink}/img/${res.content.img}`
					} else {
						throw new Error('无效的Logo响应结构')
					}
				} catch (error) {
					console.error('[Logo] 获取失败:', error)
					this.logo = '/static/fallback-logo.png'
				}
			},

			// 处理WebView消息
			handlePostMessage(e) {
				if (process.env.NODE_ENV === 'development') {
					console.log('Received post message:', e)
				}

				// 根据实际业务逻辑处理消息
				// 示例：if (e.detail.data?.type === 'specific_event') { ... }
			},
			// 获取安全的菜单图标URL
			getMenuIconUrl(iconPath) {
				return (!iconPath || this.iconErrors.has(iconPath)) ?
					DEFAULT_MENU_ICON :
					iconPath;
			},
			// 初始化轮播图数据
			async initialBannerList() {
				this.isLoading = true;

				try {
					const response = await u_bannerlist({
						terminalId: 0
					});
					this.bannerList = Array.isArray(response?.content) ?
						response.content : [];
				} catch (error) {
					console.error('[Banner] 获取失败:', error);
					uni.showToast({
						title: '轮播图加载失败',
						icon: 'none'
					});
					this.bannerList = [];
				} finally {
					this.isLoading = false;
				}
			},
			// 初始化快捷菜单数据
			async initialMenuList() {
				this.isLoading = true;

				try {
					const response = await u_midMenulist({
						terminalId: -1
					});
					let menuItems = Array.isArray(response?.content) ?
						response.content : [];

					// 处理菜单数据
					this.menuList = menuItems.map((item, index) => ({
						...item,
						id: item.id || `menu-${Date.now()}-${index}`,
						icon: item.icon ?
							`${this.baseLink}/img/${item.icon}` : DEFAULT_MENU_ICON
					}));
					this.currentQuick = menuItems[0]?.id
				} catch (error) {
					console.error('[Menu] 获取失败:', error);
					uni.showToast({
						title: '菜单加载失败',
						icon: 'none'
					});
					this.menuList = [];
				} finally {
					this.isLoading = false;
				}
			},
			// 获取安全的轮播图URL
			getBannerUrl(imgPath) {
				return imgPath ?
					`${this.baseLink}/img/${imgPath.trim()}` :
					'/static/default-banner.jpg';
			},
			getPageItems(pageIndex) {
				const start = pageIndex * 5;
				const end = start + 5;
				return this.menuData.slice(start, end);
			}
		},

		// 生命周期钩子
		async onShow() {
			this.isLoading = true
			uni.hideTabBar({
				animation: true
			}) // 移出计算属性

			try {
				// 并行初始化任务
				await Promise.allSettled([
					this.initialScreenInfo(),
					this.initialLogo(),
					this.initialBannerList(),
					this.initialMenuList()
				])

				// 更新时间戳确保每次进入都刷新webview
				this.nowTimestamp = Date.now()
			} catch (error) {
				console.error('初始化失败:', error)
			} finally {
				this.isLoading = false
			}
		}
	}
</script>

<style scoped>
	/* ===== 基础布局 ===== */
	.container {
		width: 750rpx;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
	}

	/* 轮播图 */
	.content-container {
		margin: 0 10rpx;
	}

	.swiper {
		border-radius: 10rpx;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
	}

	.swiper-image {
		width: 750rpx;
		height: 150px;
	}

	/* ===== 导航栏样式 ===== */
	.custom-navbar {
		padding: 20rpx;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.logo-container {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.logo-img {
		width: 40rpx;
		height: 40rpx;
	}

	.title {
		font-family: 'PingFang SC', system-ui, sans-serif;
		font-weight: 700;
		font-size: 34rpx;
		color: #333;
		margin-left: 15px;
	}

	/* 登录信息样式 */
	.login-info,
	.login-btn {
		font-size: 28rpx;
		padding: 8rpx 16rpx;
		border-radius: 8rpx;
	}

	.login-btn {
		background-color: red;
		color: white;
	}

	.quick-container {
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
		margin: 0 10rpx;
		height: 200rpx;
	}


	/* 菜单网格布局 */
	.menu-grid {
		display: flex;
		flex-direction: row;
		justify-content: flex-start;
		padding: 30rpx 0;
	}

	/* 菜单项样式 */
	.menu-item-current {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 120rpx;
		margin-left: 5px;
	}

	/* 图标样式 */
	.menu-icon {
		width: 43rpx;
		height: 32rpx;
	}

	/* 文本样式 */
	.menu-text {
		font-size: 12px;
	}
</style>