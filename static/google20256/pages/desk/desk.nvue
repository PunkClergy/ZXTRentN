<template>
	<view class="container" :style="containerStyle" @touchmove.prevent="handleTouchMove">
		<!-- 头部内容 -->
		<view class="custom-navbar" :style="navbarStyle">
			<view class="logo-container">
				<image :src="safeLogo" mode="widthFix" @tap="handleJumpHome" class="logo-img" />
				<text class="title">智信通wiselink</text>
			</view>

			<!-- 用户登录状态 -->
			<view v-if="userInfo" class="login-info">
				<view class="login-info-text">
					<text>{{ userCompanyName }}</text>
					<text>({{ lang.signedin }})</text>
				</view>
				<view @tap="handleSwitchLanguage" class="login-btn-lang">{{lang.language}}</view>
			</view>
			<view v-else class="login-btn">
				<view class="login-info-text login-btn-color" @tap.stop="handleNavigateToLogin">
					<text>{{ lang.signin }}</text>
				</view>
				<view @tap="handleSwitchLanguage" class="login-btn-lang">{{lang.language}}</view>
			</view>
		</view>

		<!-- 轮播图 -->
		<view class="content-container">
			<swiper class="swiper" :autoplay="true" :interval="3000" :duration="500">
				<swiper-item v-for="(item, index) in bannerList" :key="index">
					<image :src="getBannerUrl(item.img)" mode="aspectFill" class="swiper-image"
						@click="handleSwiperClick(item)" />
				</swiper-item>
			</swiper>
		</view>

		<!-- 快捷菜单区域 -->

		<swiper :autoplay="true" :interval="3000" :duration="500" indicator-dots="true" style="height: 130px;">
			<swiper-item v-for="(page, pageIndex) in menuPages" :key="pageIndex">
				<view class="quick-layout">
					<view class="quick-menu-item" v-for="(item, itemIndex) in page"
						:key="`menu-${item.id || itemIndex}`">
						<view v-if="!item.isDuplicated" @tap="handleMenuItemTap(item)"
							:style="{background: getGradient((pageIndex * page.length + itemIndex))}"
							class="quick-menu-content">
							<view><text class="quick-menu-title">{{item.name}}</text></view>
							<view><text class="quick-menu-desc">{{item.name}}</text></view>
							<view><text class="quick-menu-details">{{item.name}}</text></view>
							<view class="quick-icon">
								<image :src="getMenuIconUrl(item.icon)" style="width: 82rpx;height: 61rpx;"></image>
							</view>
						</view>
					</view>
				</view>

			</swiper-item>
		</swiper>

		<!-- 主内容区域 -->
		<view class="main-content" :style="{ height: contentHeight + 'px' }">
			<block v-if="currentQuick==540">
				<web-view ref="webview" @onPostMessage="handlePostMessage" :src="webUrlWithTimestamp"
					:style="{ height: contentHeight + 'px' }">
				</web-view>
			</block>
			<block v-else>
				<view class="main-content-container" :style="{ height: contentHeight + 'px' }">
					<!-- 左侧导航 -->
					<scroll-view scroll-y class="left-nav" :style="{ height: contentHeight + 'px' }">
						<view v-for="(item, index) in main_coverage" :key="index" class="category-item"
							:class="{ active: activeIndex === index }" @tap="switchCategory(index)">
							<text class="category-item-text"
								:class="{ active: activeIndex === index }">{{currentLang =='en-US'?item.enname:item.name}}</text>
						</view>
					</scroll-view>

					<!-- 右侧内容 -->
					<scroll-view scroll-y class="right-content" :scroll-top="scrollTop" @scroll="onScroll"
						scroll-with-animation :style="{ height: contentHeight + 'px' }">
						<view v-for="(item, index) in main_coverage" :key="index" class="right-category"
							:id="`category-${index}`" :data-index="index">
							<view class="category-title" style="display: flex;flex-direction: row;align-items: center;">
								<view style="width: 12rpx;height: 23rpx;background: red;border-radius: 6rpx;margin-right: 10rpx;"></view>
								<view><text style="font-family: PingFang SC;font-weight: 500;font-size: 30rpx;color: #5B5959;">{{currentLang =='en-US'?item.enname:item.name}}</text></view>
							</view>
							<view class="child-grid">
								<view v-for="(citem, cindex) in item.children" :key="cindex"
									style="width: 150rpx;margin-left: 2rpx;">
									<view class="child-content" @tap="handleChildItemTap(citem)"
										:style="{opacity:citem?.isdevelop == 0?0.5:1}">
										<image :src="`${baseLink}/img/${citem.icon}`" class="child-icon" />
										<text
											class="child-text">{{currentLang =='en-US'?citem.enname:citem.name}}</text>
									</view>
								</view>
								<!-- 子菜单项 -->
							</view>
						</view>
					</scroll-view>
				</view>
			</block>
		</view>
	</view>
</template>

<script>
	import {
		info_screen
	} from '@/utils/scheme/screen.js'
	import {
		u_logo,
		u_bannerlist,
		u_midMenulist,
		u_rightMenulist,
		u_getCarPoisitonWx,
		u_getCarPoisiton,
		u_operation
	} from '@/api'
	import 'url-search-params-polyfill';
	import {
		setLang,
		getLang,
		getCurrentLangCode
	} from '@/utils/i18n/index.js'
	const DEFAULT_MENU_ICON = '/static/public/default-icon.png';
	const MENU_ITEMS_PER_PAGE = 4; // 每页菜单项数量

	export default {
		data() {
			return {
				gradients: [
					'linear-gradient(60deg, #1A71C1, #41A0FC)',
					'linear-gradient(60deg, #15B492, #1BE0C0)',
					'linear-gradient(60deg, #E9B417, #FDCE2B)',
					'linear-gradient(60deg, #C41193, #EF0FB2)'
				],
				screenInfo: {}, // 屏幕信息对象
				logo: '', // Logo图片地址
				baseLink: 'https://k1sw.wiselink.net.cn', // 基础域名
				isLoading: false,
				nowTimestamp: Date.now(), // 缓存时间戳
				// 轮播图数据
				bannerList: [],
				menuList: [], // 菜单原始数据
				imageErrors: new Set(), // 图片加载错误记录
				iconErrors: new Set(), // 图标加载错误记录
				contentHeight: 0, // 动态计算内容高度
				currentQuick: '', //当前点击快捷入口ID
				main_coverage: [], // 主内容区域数据
				scrollTop: 0, // 右侧滚动位置
				activeIndex: 0, // 当前激活的分类索引
				categoryPositions: [], // 存储分类位置信息
				scrollTimer: null, // 滚动防抖计时器
				lang: getLang(), // 默认语言库
				currentLang: getCurrentLangCode() //当前语言
			}
		},
		computed: {
			// 当前用户信息
			userInfo() {
				return uni.getStorageSync('user_info') || null
			},
			// 有效的菜单数据
			validMenuItems() {
				return this.menuList.filter(item => item?.name?.trim());
			},
			// 是否有菜单数据
			hasMenuData() {
				return this.validMenuItems.length > 0 && !this.isLoading;
			},
			// 安全的公司名称显示
			userCompanyName() {
				return this.userInfo?.companyName?.trim() || '未知'
			},
			// 菜单分页数据
			menuPages() {
				const pageSize = 4;
				const originalItems = this.validMenuItems;

				if (originalItems.length === 0) {
					return [];
				}

				// 先复制所有原始项（保持原样，不加标记）
				const items = originalItems.map(item => ({
					...item
				}));

				// 计算需要补多少个
				const remainder = items.length % pageSize;
				if (remainder > 0) {
					const lastItem = originalItems[originalItems.length - 1]; // 原始最后一项
					const paddingCount = pageSize - remainder;

					// 补充：每个补充项都是 lastItem 的副本 + 标记字段
					for (let i = 0; i < paddingCount; i++) {
						items.push({
							...lastItem,
							isDuplicated: true // 标记为重复补全项
						});
					}
				}

				// 分页
				const pages = [];
				for (let i = 0; i < items.length; i += pageSize) {
					pages.push(items.slice(i, i + pageSize));
				}

				return pages;
			},
			// 导航栏总高度
			navbarTotalHeight() {
				const statusBarHeight = this.screenInfo.statusBarHeight || 0
				const navBarHeight = this.screenInfo.platform === 'ios' ? 49 : 44
				return statusBarHeight + navBarHeight
			},

			// 安全的Logo地址
			safeLogo() {
				return this.logo || '/static/default-logo.png'
			},

			// 容器样式
			containerStyle() {
				return {
					height: `${this.screenInfo.screenHeight || 667}px`
				}
			},

			// 导航栏样式
			navbarStyle() {
				return {
					marginTop: `${this.screenInfo.statusBarHeight}px`,
					width: `${this.screenInfo.screenWidth}px`
				}
			},

			// 带时间戳的Web URL
			webUrlWithTimestamp() {
				return `/hybrid/html/homePgae.html?nowTime=${this.nowTimestamp}`
			}
		},
		mounted() {
			this.initSearchLink()

		},
		methods: {
			getGradient(index) {
				return this.gradients[index % this.gradients.length];
			},
			// 切换语言
			handleSwitchLanguage() {
				try {
					const pages = getCurrentPages();
					if (!pages.length) return;

					const currentPage = pages[pages.length - 1];
					const currentPath = '/' + currentPage.route;
					const query = Object.entries(currentPage.options || {})
						.map(([k, v]) => `${k}=${encodeURIComponent(JSON.stringify(v))}`)
						.join('&');

					// 切换语言
					setLang(getCurrentLangCode() === 'en-US' ? 'zh-CN' : 'en-US');

					// 重载页面
					setTimeout(() => {
						uni.redirectTo({
							url: currentPath + (query ? `?${query}` : ''),
							fail: (err) => {
								console.error('页面重载失败', err);
								uni.reLaunch({
									url: currentPath
								});
							}
						});
					}, 100);
				} catch (e) {
					console.error('语言切换错误', e);
					uni.showToast({
						title: '语言切换失败',
						icon: 'none'
					});
				}
			},
			// 项HTML发送数据前先请求拿到数据
			async initSearchLink() {
				let scene = '640019899'
				const temp = {
					sn: scene
				}
				try {
					const res = await u_getCarPoisiton(temp)
					const info = res.content
					setTimeout(() => {
						this.sendDataToWebview({
							type: 'desk',
							payload: info,
							lang: this.currentLang
						});
					}, 2000);
				} catch (error) {
					console.error('请求失败:', error)
				}
			},

			// 向 HTML 发送数据
			sendDataToWebview(data) {
				const payload = JSON.stringify(data);
				const jsStr = `window.postMessage(${payload}, '*')`;
				// APP 端使用 evalJS
				// #ifdef APP-PLUS
				const webview = this.$refs.webview;
				webview.evalJS(jsStr);
				// #endif

				// H5 端直接调用 iframe 方法
				// #ifdef H5
				const iframe = document.querySelector('web-view iframe');
				iframe?.contentWindow?.postMessage(data, '*');
				// #endif
			},
			// 处理WebView消息
			handlePostMessage(e) {
				// 更安全的类型检测和错误处理
				const messageData = e?.detail?.data?.[0] || {};
				const {
					type
				} = messageData;

				if (!type) {
					console.warn('Received message without type:', e);
					return;
				}

				// 使用策略模式替代多重 if 判断
				const ACTION_HANDLERS = {
					3: () => {
						console.log('开锁操作');
						this.handleVehicle(type);
					},
					1: () => {
						console.log('关锁操作');
						this.handleVehicle(type);
					},
					5: () => {
						console.log('寻车操作');
						this.handleVehicle(type);
					},
					'btnSee': () => {
						console.log('查看照片，跳转');
						this.handlePhotoView();
					},
					'btnReturn': () => {
						console.log('归还车辆，跳转');
						this.handleReturnVehicle();
					}
				};

				// 执行对应的处理函数
				const handler = ACTION_HANDLERS[type];
				if (handler) {
					handler();
				} else {
					console.warn(`未处理的 message 类型: ${type}`, messageData);
				}
			},
			// 控制车辆
			async handleVehicle(evt) {
				try {
					const controlType = evt;
					const requestParam = {
						sn: '640019899',
						operationType: controlType,
						_timestamp: Date.now()
					};
					const res = await u_operation(requestParam)
					uni.showToast({
						title: res.msg,
						icon: 'none',
						duration: 2000,
					});

				} catch (error) {}
			},
			// 阻止默认滚动行为
			handleTouchMove() {
				return false
			},

			// 跳转首页
			handleJumpHome() {
				uni.reLaunch({
					url: '/pages/desk/desk'
				})
			},

			// 跳转登录页
			handleNavigateToLogin() {
				uni.navigateTo({
					url: '/pages/login/login'
				})
			},

			// 初始化屏幕信息
			async initialScreenInfo() {
				try {
					this.screenInfo = await info_screen()
					this.calculateContentHeight(); // 获取屏幕信息后计算内容高度

					if (process.env.NODE_ENV === 'development') {
						console.log('Screen info:', this.screenInfo)
					}
				} catch (error) {
					console.error('[ScreenInfo] 获取屏幕信息失败:', error)
					uni.showToast({
						title: '设备信息获取失败',
						icon: 'none'
					})
				}
			},

			// 计算内容高度
			calculateContentHeight() {
				if (!this.screenInfo.screenHeight) return;

				// 将rpx转换为px的辅助函数
				const rpx2px = (rpx) => {
					return (rpx * this.screenInfo.screenWidth) / 750;
				};

				// 计算各组件高度
				const navBarHeight = this.navbarTotalHeight;
				const navBarPadding = rpx2px(40); // 20rpx*2
				const bannerHeight = 150; // 轮播图固定高度(px)
				const quickMenuHeight = rpx2px(200); // 快捷菜单高度(rpx转px)

				// 计算剩余高度
				const remainingHeight = this.screenInfo.screenHeight -
					navBarHeight -
					navBarPadding -
					bannerHeight -
					quickMenuHeight;

				// 设置内容高度（不小于0）
				this.contentHeight = Math.max(remainingHeight, 0);
			},

			// 初始化应用Logo
			async initialLogo() {
				try {
					const res = await u_logo()
					if (res?.content?.img) {
						this.logo = `${this.baseLink}/img/${res.content.img}`
					} else {
						throw new Error('无效的Logo响应结构')
					}
				} catch (error) {
					console.error('[Logo] 获取失败:', error)
					this.logo = '/static/fallback-logo.png'
				}
			},



			// 获取安全的菜单图标URL
			getMenuIconUrl(iconPath) {
				return (!iconPath || this.iconErrors.has(iconPath)) ?
					DEFAULT_MENU_ICON :
					iconPath;
			},

			// 初始化轮播图数据
			async initialBannerList() {
				this.isLoading = true;

				try {
					const response = await u_bannerlist({
						terminalId: 0
					});
					this.bannerList = Array.isArray(response?.content) ?
						response.content : [];
				} catch (error) {
					console.error('[Banner] 获取失败:', error);
					uni.showToast({
						title: '轮播图加载失败',
						icon: 'none'
					});
					this.bannerList = [];
				} finally {
					this.isLoading = false;
				}
			},

			// 初始化快捷菜单数据
			async initialMenuList() {
				this.isLoading = true;

				try {
					const response = await u_midMenulist({
						terminalId: -1
					});
					let menuItems = Array.isArray(response?.content) ?
						response.content : [];

					// 处理菜单数据
					this.menuList = menuItems.map((item, index) => ({
						...item,
						id: item.id || `menu-${Date.now()}-${index}`,
						icon: item.icon ?
							`${this.baseLink}/img/${item.icon}` : DEFAULT_MENU_ICON
					}));
					console.log(menuItems)
					this.currentQuick = menuItems[0]?.id || '';
					this.handleMenuItemTap(menuItems[0])
				} catch (error) {
					console.error('[Menu] 获取失败:', error);
					uni.showToast({
						title: '菜单加载失败',
						icon: 'none'
					});
					this.menuList = [];
				} finally {
					this.isLoading = false;
				}
			},

			// 获取安全的轮播图URL
			getBannerUrl(imgPath) {
				return imgPath ?
					`${this.baseLink}/img/${imgPath.trim()}` :
					'/static/default-banner.jpg';
			},



			// 处理菜单图标错误
			handleMenuIconError(id) {
				this.iconErrors.add(id);
			},

			// 处理轮播图错误
			handleSwiperError(id) {
				this.imageErrors.add(id);
			},

			// 轮播图点击
			handleSwiperClick(item) {
				if (item.url) {
					uni.navigateTo({
						url: item.url
					});
				}
			},

			// 子菜单项点击
			handleChildItemTap(item) {
				if (!item.isdevelop) {
					uni.showToast({
						title: '暂未开通，敬请期待',
						icon: 'none'
					});
					return;
				}
				if (item.name == '退出登录') {
					uni.showModal({
						title: '提示',
						content: '确定退出当前账号？',
						success: (res) => {
							if (res.confirm) {
								uni.clearStorageSync();
								uni.reLaunch({
									url: '/pages/desk/desk', // 替换成你的首页实际路径
									success: () => {
										console.log("跳转到首页成功");
									},
									fail: (err) => {
										console.error("跳转到首页失败：", err);
									}
								});
							} else if (res.cancel) {
								console.log('用户点击取消');
								// 这里写取消后的逻辑
							}
						}
					});
					return
				}
				if (item.path) {
					uni.navigateTo({
						url: item.path
					});
				}
			},



			// 切换分类 - 修复定位问题
			switchCategory(index) {
				this.activeIndex = index;

				// 确保DOM更新完成
				this.$nextTick(() => {
					// 使用scroll-into-view实现精准定位
					this.scrollTop = 0; // 重置滚动位置
					this.$nextTick(() => {
						this.currentViewId = `category-${index}`;
						this.scrollTop = -1; // 强制刷新
						this.$nextTick(() => {
							this.scrollTop = 0;
						});
					});

					// 备用方案：使用节点查询
					this.scrollToCategory(index);
				});
			},

			// 精准滚动到指定分类
			scrollToCategory(index) {
				const query = uni.createSelectorQuery().in(this);
				query.select(`#category-${index}`).boundingClientRect().exec(res => {
					if (res && res[0]) {
						const rect = res[0];
						if (rect) {
							// 计算正确的滚动位置
							const currentScrollTop = this.scrollTop;
							const targetPosition = rect.top + currentScrollTop;

							// 设置滚动位置（添加偏移量避免被标题栏遮挡）
							this.scrollTop = targetPosition - 50;
						}
					}
				});
			},

			// 滚动处理 - 优化性能
			onScroll(e) {
				// 防抖处理
				if (this.scrollTimer) {
					clearTimeout(this.scrollTimer);
				}

				this.scrollTimer = setTimeout(() => {
					const scrollTop = e.detail.scrollTop;
					this.updateActiveCategory(scrollTop);
				}, 50);
			},

			// 更新激活分类 - 优化算法
			updateActiveCategory(scrollTop) {
				// 初始化位置信息
				if (this.categoryPositions.length === 0) {
					this.initCategoryPositions();
				}

				// 查找当前激活的分类
				for (let i = 0; i < this.categoryPositions.length; i++) {
					const current = this.categoryPositions[i];
					const next = this.categoryPositions[i + 1];

					if (scrollTop >= current.top &&
						(!next || scrollTop < next.top)) {
						if (this.activeIndex !== i) {
							this.activeIndex = i;
						}
						break;
					}
				}
			},

			// 初始化分类位置信息
			initCategoryPositions() {
				this.categoryPositions = [];
				const promises = [];

				this.main_coverage.forEach((_, index) => {
					const query = uni.createSelectorQuery().in(this);
					promises.push(new Promise(resolve => {
						query.select(`#category-${index}`).boundingClientRect().exec(res => {
							if (res && res[0]) {
								this.categoryPositions[index] = {
									top: res[0].top,
									height: res[0].height
								};
							}
							resolve();
						});
					}));
				});

				// 等待所有位置查询完成
				Promise.all(promises).then(() => {
					// 转换为绝对位置
					let currentTop = 0;
					this.categoryPositions = this.categoryPositions.map(pos => {
						const result = {
							top: currentTop,
							height: pos.height
						};
						currentTop += pos.height;
						return result;
					});
				});
			},

			// 菜单项点击处理 - 增加位置初始化
			async handleMenuItemTap(item) {
				console.log(item, 'ididdi')
				try {
					const response = await u_rightMenulist({
						menuId: item?.id,
						isDir: 1
					});

					this.main_coverage = response?.content || [];
					await this.$nextTick();

					// 重置位置信息
					this.categoryPositions = [];
					this.activeIndex = 0;
					this.scrollTop = 0;
					this.currentQuick = item?.id || '';

					// 初始化位置信息
					this.$nextTick(() => {
						setTimeout(() => this.initCategoryPositions(), 300);
						this.initSearchLink()
					});
				} catch (error) {
					console.error('[MainCoverage] 获取失败:', error);
					uni.showToast({
						title: '内容加载失败',
						icon: 'none'
					});
				}
			},
		},

		// 生命周期钩子
		async onLoad() {
			this.isLoading = true;
			uni.hideTabBar({
				animation: true
			});

			try {
				await Promise.allSettled([
					this.initialScreenInfo(),
					this.initialLogo(),
					this.initialBannerList(),
					this.initialMenuList()
				]);

				this.nowTimestamp = Date.now();
			} catch (error) {
				console.error('初始化失败:', error);
			} finally {
				this.isLoading = false;
			}
			this.initSearchLink()

		},

		onReady() {
			this.calculateContentHeight();
		},

		onResize() {
			// 屏幕尺寸变化时重新计算高度
			this.calculateContentHeight();
		}
	}
</script>

