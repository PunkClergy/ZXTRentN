<template>
	<view class="container" :style="containerStyle" @touchmove.prevent="handleTouchMove">
		<CustomNavBar title="车务使用电子钥匙" />
		<view class="select-region">
			<view class="select-vehicle" @tap="handleJumpVehicle" v-if="!vehicle_info?.sn">
				<text>选择车辆</text>
				<image src="/static/public/left.png" class="select-vehicle-image"></image>
			</view>
			<view v-else>
				<view
					style="display: flex;flex-direction: row;justify-content: space-between;width: 730rpx;border-bottom: 1px solid #f0f0f0;padding: 20rpx;">
					<view>{{vehicle_info?.sn}}</view>
					<view>43243432</view>
				</view>
				<view
					style="display: flex;width: 730rpx;flex-direction: row;justify-content: space-between;padding: 20rpx;">
					<view>
						车架号：222
					</view>
					<view>油箱容积：222</view>
				</view>
			</view>
		</view>

		<view class="web-view-container">
			<web-view ref="webview" @onPostMessage="handlePostMessage" :src="webUrlWithTimestamp"
				:style="{ height: contentHeight + 'px' }">
			</web-view>
		</view>
	</view>
</template>

<script>
	import { info_screen } from '@/utils/scheme/screen.js'
	import { u_getAllCarPoisiton } from '@/api'
	import 'url-search-params-polyfill';
	import CustomNavBar from "@/components/custom-header/index.nvue";
	
	// 常量定义
	const DATA_SEND_INTERVAL = 2000;
	const NAVBAR_HEIGHT = {
	  ios: 49,
	  android: 44,
	  default: 44
	};
	
	export default {
	  components: { CustomNavBar },
	  
	  data: () => ({
	    screenInfo: {},
	    nowTimestamp: Date.now(),
	    vehicle_info: {},
	    info: [],
	    isLoading: false,
	    sendDataTimeout: null
	  }),
	  
	  computed: {
	    containerStyle() {
	      return { height: `${this.screenInfo.screenHeight || 667}px` };
	    },
	    
	    webUrlWithTimestamp() {
	      return `/hybrid/html/sendKey.html?nowTime=${this.nowTimestamp}`;
	    },
	    
	    statusBarHeight() {
	      return this.screenInfo.statusBarHeight || 0;
	    },
	    
	    navBarHeight() {
	      return NAVBAR_HEIGHT[this.screenInfo.platform] || NAVBAR_HEIGHT.default;
	    },
	    
	    contentHeight() {
	      const { screenHeight } = this.screenInfo;
	      return screenHeight - (this.statusBarHeight + this.navBarHeight + 60);
	    }
	  },
	
	  onLoad(options) {
	    this.vehicle_info = JSON.parse(options?.info || '{}');
	    this.initialScreenInfo();
	  },
	
	  async onShow() {
	    this.isLoading = true;
	    uni.hideTabBar({ animation: true });
	    
	    try {
	      this.nowTimestamp = Date.now();
	      await this.initSearchLink();
	    } catch (error) {
	      console.error('数据初始化失败:', error);
	      uni.showToast({ 
	        title: '数据加载失败', 
	        icon: 'none' 
	      });
	    } finally {
	      this.isLoading = false;
	    }
	  },
	  
	  onUnload() {
	    this.clearSendDataTimer();
	  },
	
	  methods: {
	    // 初始化屏幕信息
	    async initialScreenInfo() {
	      try {
	        this.screenInfo = await info_screen();
	        if (process.env.NODE_ENV === 'development') {
	          console.log('Screen info:', this.screenInfo);
	        }
	      } catch (error) {
	        console.error('[ScreenInfo] 获取屏幕信息失败:', error);
	        uni.showToast({ 
	          title: '设备信息获取失败', 
	          icon: 'none' 
	        });
	      }
	    },
	
	    // 获取车辆位置数据
	    async initSearchLink() {
	      try {
	        const res = await u_getAllCarPoisiton();
	        this.info = res.content || [];
	        this.sendDataToWebviewDebounced();
	      } catch (error) {
	        console.error('车辆位置请求失败:', error);
	      }
	    },
	
	    // 防抖发送数据
	    sendDataToWebviewDebounced() {
	      this.clearSendDataTimer();
	      this.sendDataTimeout = setTimeout(() => {
	        this.sendDataToWebview({
	          type: 'elctrncky',
	          payload: this.info,
	          vehicle_info: this.vehicle_info
	        });
	      }, DATA_SEND_INTERVAL);
	    },
	
	    // 清理定时器
	    clearSendDataTimer() {
	      if (this.sendDataTimeout) {
	        clearTimeout(this.sendDataTimeout);
	        this.sendDataTimeout = null;
	      }
	    },
	
	    // 向Webview发送数据
	    sendDataToWebview(data) {
	      const payload = JSON.stringify(data);
	      const jsStr = `window.postMessage(${payload}, '*')`;
	      
	      // APP端处理
	      // #ifdef APP-PLUS
	      this.$refs.webview?.evalJS(jsStr);
	      // #endif
	      
	      // H5端处理
	      // #ifdef H5
	      const iframe = document.querySelector('web-view iframe');
	      iframe?.contentWindow?.postMessage(data, '*');
	      // #endif
	    },
	
	    // 页面跳转
	    handleJumpVehicle() {
	      uni.redirectTo({
	        url: `/pages/carRental/vehicleList/index?souce=/pages/carRental/carServiceKey/carServiceKey`
	      });
	    },
	
	    // 消息处理
	    handlePostMessage(evt) {
	      const targetSn = evt.detail.data[0]?.sn;
	      if (!targetSn) return;
	      
	      const matchedItem = this.info.find(item => item.sn === targetSn);
	      if (matchedItem) {
	        this.vehicle_info = matchedItem;
	      }
	    }
	  }
	}
</script>

<style>
	/* ===== 基础布局 ===== */
	.container {
		width: 750rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.select-region {
		width: 740rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10rpx;
		border-radius: 6rpx 10rpx;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		background-color: #fff;
		margin-bottom: 5rpx;
	}

	.select-vehicle-image {
		width: 50rpx;
		height: 50rpx;
	}

	.web-view-container {
		width: 740rpx;
	}

	.select-vehicle {
		width: 720rpx;
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		border-radius: 8px;
		height: 50px;
		background-color: aliceblue;
	}
</style>