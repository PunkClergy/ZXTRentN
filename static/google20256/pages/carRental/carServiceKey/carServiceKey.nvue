<template>
	<view class="container" :style="containerStyle" @touchmove.prevent="handleTouchMove"
		style="background-color: aqua;">
		<CustomNavBar title="车务使用电子钥匙" />
		<view class="select-region">
			<view class="select-vehicle" @tap="handleJumpVehicle" v-if="!vehicle_info?.sn">
				<text>选择车辆</text>
				<image src="/static/public/left.png" class="select-vehicle-image"></image>
			</view>
			<view v-else>
				<view
					style="display: flex;flex-direction: row;justify-content: space-between;width: 730rpx;border-bottom: 1px solid #f0f0f0;padding: 20rpx;">
					<view>{{vehicle_info?.sn}}</view>
					<view>43243432</view>
				</view>
				<view
					style="display: flex;width: 730rpx;flex-direction: row;justify-content: space-between;padding: 20rpx;">
					<view>
						车架号：222
					</view>
					<view>油箱容积：222</view>
				</view>
			</view>
		</view>

		<view class="web-view-container">
			<web-view ref="webview" @onPostMessage="handlePostMessage" :src="webUrlWithTimestamp"
				:style="{ height: contentHeight + 'px' }">
			</web-view>
		</view>
	</view>
</template>

<script>
	import {
		info_screen
	} from '@/utils/scheme/screen.js'
	import {
		u_getAllCarPoisiton
	} from '@/api'
	import 'url-search-params-polyfill';
	import CustomNavBar from "@/components/custom-header/index.nvue";
	export default {
		data() {
			return {
				screenInfo: {}, // 屏幕信息对象
				nowTimestamp: Date.now(), // 缓存时间戳
				vehicle_info: {}, //车辆信息
			}
		},
		components: {
			CustomNavBar
		},
		onLoad(options) {
			console.log(22222222222222, options)
			this.initVehicleInfo(options?.info)
		},
		mounted() {
			this.initSearchLink()

		},
		methods: {
			// 请求车辆信息
			initVehicleInfo(evt) {
				this.vehicle_info = JSON.parse(evt)
				// 初始化位置信息
				this.$nextTick(() => {
					this.initSearchLink()
				});
			},
			// 项HTML发送数据前先请求拿到数据
			async initSearchLink() {
				try {
					const res = await u_getAllCarPoisiton()
					const info = res.content
					setTimeout(() => {
						this.sendDataToWebview({
							type: 'elctrncky',
							payload: info,
							vehicle_info: this.vehicle_info
						});
					}, 2000);
				} catch (error) {
					console.error('请求失败:', error)
				}
			},
			// 向 HTML 发送数据
			sendDataToWebview(data) {
				const payload = JSON.stringify(data);
				const jsStr = `window.postMessage(${payload}, '*')`;
				// APP 端使用 evalJS
				// #ifdef APP-PLUS
				const webview = this.$refs.webview;
				webview.evalJS(jsStr);
				// #endif

				// H5 端直接调用 iframe 方法
				// #ifdef H5
				const iframe = document.querySelector('web-view iframe');
				iframe?.contentWindow?.postMessage(data, '*');
				// #endif
			},
			async initialScreenInfo() {
				try {
					this.screenInfo = await info_screen()


					if (process.env.NODE_ENV === 'development') {
						console.log('Screen info:', this.screenInfo)
					}
				} catch (error) {
					console.error('[ScreenInfo] 获取屏幕信息失败:', error)
					uni.showToast({
						title: '设备信息获取失败',
						icon: 'none'
					})
				}
			},
			handleJumpVehicle() {
				uni.redirectTo({
					url: `/pages/carRental/vehicleList/index?souce=/pages/carRental/carServiceKey/carServiceKey`
				});
			},
			handlePostMessage(evt) {
				console.log(evt)
			}
		},
		computed: {
			// 容器样式
			containerStyle() {
				return {
					height: `${this.screenInfo.screenHeight || 667}px`
				}
			},
			// 带时间戳的Web URL
			webUrlWithTimestamp() {
				return `/hybrid/html/sendKey.html?nowTime=${this.nowTimestamp}`
			},
			// 状态栏高度
			statusBarHeight() {
				return this.screenInfo.statusBarHeight || 0;
			},
			// 导航栏主体高度
			navBarHeight() {
				return this.screenInfo.platform === 'ios' ? 49 : 44;
			},
			contentHeight(config = {}) {
				const {
					screenHeight,
					statusBarHeight,
					platform
				} = this.screenInfo;
				const {
					navBarHeight = {
						ios: 49,
						android: 44
					}
				} = config;

				const navHeight = navBarHeight[platform] || navBarHeight.default || 44;
				const rong = 10

				return screenHeight - (statusBarHeight + navHeight + 50 + rong);
			}
		},
		async onShow() {
			this.isLoading = true;
			uni.hideTabBar({
				animation: true
			});

			try {
				await Promise.allSettled([
					this.initialScreenInfo(),
				]);

				this.nowTimestamp = Date.now();
			} catch (error) {
				console.error('初始化失败:', error);
			} finally {
				this.isLoading = false;
			}
			this.initSearchLink()
		},
	}
</script>

<style>
	/* ===== 基础布局 ===== */
	.container {
		width: 750rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.select-region {
		width: 740rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10rpx;
		border-radius: 6rpx 10rpx;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		background-color: #fff;
		margin-bottom: 5rpx;
	}

	.select-vehicle-image {
		width: 50rpx;
		height: 50rpx;
	}

	.web-view-container {
		width: 740rpx;
	}

	.select-vehicle {
		width: 720rpx;
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		border-radius: 8px;
		height: 50px;
		background-color: aliceblue;
	}
</style>