<!-- 公共头部组件：common-header.nvue -->
<template>
  <view class="common-header">
    <!-- 左侧Logo和标题 -->
    <view class="header-left" @click="handleLogoClick">
      <image class="logo" src="/static/logo.png" />
      <text class="app-title">{{ title }}</text>
    </view>
    
    <!-- 右侧登录按钮 -->
    <view class="header-right">
      <text class="login-btn" @click="handleLogin">
        去登录
        <text class="badge" v-if="showBadge">1</text>
      </text>
    </view>
  </view>
</template>

<script>
export default {
  props: {
    title: {
      type: String,
      default: "应用名称"
    },
    showBadge: {
      type: Boolean,
      default: false
    }
  },
  
  methods: {
    handleLogoClick() {
      uni.reLaunch({
        url: '/pages/index/index'
      });
    },
    
    handleLogin() {
      uni.navigateTo({
        url: '/pages/login/login'
      });
    }
  }
}
</script>

